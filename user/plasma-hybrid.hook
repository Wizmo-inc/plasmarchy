#!/bin/bash

# Carry the active Omarchy palette and wallpaper into Plasma/KWin. Omarchy's
# own shell palette is applied through the KDE-aware omarchy-shell shim.

theme_root="$HOME/.local/state/omarchy/current/theme"
colors_file="$theme_root/colors.toml"
scheme_dir="$HOME/.local/share/color-schemes"
scheme_file="$scheme_dir/Omarchy.colors"
icons_file="$theme_root/icons.theme"
hook_event=${1:-theme-change}

[[ -f $colors_file ]] || exit 0

toml_color() {
  local key="$1"
  awk -F= -v wanted="$key" '
    $1 ~ "^[[:space:]]*" wanted "[[:space:]]*$" {
      value=$2
      gsub(/[[:space:]"]/, "", value)
      print value
      exit
    }
  ' "$colors_file"
}

rgb() {
  local value="${1#\#}"
  printf '%d,%d,%d' "0x${value:0:2}" "0x${value:2:2}" "0x${value:4:2}"
}

background=$(toml_color background)
lighter=$(toml_color lighter_background)
foreground=$(toml_color foreground)
muted=$(toml_color muted)
accent=$(toml_color accent)
selection=$(toml_color selection)

mkdir -p "$scheme_dir"
scheme_tmp="$scheme_file.tmp.$$"
cat >"$scheme_tmp" <<EOF
[General]
Name=Omarchy
ColorScheme=Omarchy
shadeSortColumn=true

[Colors:Window]
BackgroundNormal=$(rgb "$background")
ForegroundNormal=$(rgb "$foreground")
DecorationFocus=$(rgb "$accent")
DecorationHover=$(rgb "$accent")

[Colors:View]
BackgroundNormal=$(rgb "$background")
ForegroundNormal=$(rgb "$foreground")
BackgroundAlternate=$(rgb "$lighter")
DecorationFocus=$(rgb "$accent")
DecorationHover=$(rgb "$accent")

[Colors:Button]
BackgroundNormal=$(rgb "$lighter")
ForegroundNormal=$(rgb "$foreground")
DecorationFocus=$(rgb "$accent")
DecorationHover=$(rgb "$accent")

[Colors:Selection]
BackgroundNormal=$(rgb "$accent")
ForegroundNormal=$(rgb "$background")

[Colors:Tooltip]
BackgroundNormal=$(rgb "$background")
ForegroundNormal=$(rgb "$foreground")

[Colors:Complementary]
BackgroundNormal=$(rgb "$background")
ForegroundNormal=$(rgb "$foreground")
BackgroundAlternate=$(rgb "$lighter")

[WM]
activeBackground=$(rgb "$background")
activeForeground=$(rgb "$foreground")
inactiveBackground=$(rgb "$background")
inactiveForeground=$(rgb "$muted")
activeBlend=$(rgb "$accent")
inactiveBlend=$(rgb "$selection")
EOF
mv "$scheme_tmp" "$scheme_file"

# The tool intentionally skips a scheme that is already active. Since this
# file is rewritten in place, briefly select a stock scheme during a live
# theme change so Plasma applications invalidate their cached palette.
if [[ $hook_event != install && $hook_event != session-start ]] &&
   [[ $(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null) == Omarchy ]]; then
  if [[ $(omarchy-theme-color --file "$colors_file" mode 2>/dev/null || true) == light ]]; then
    plasma-apply-colorscheme BreezeLight >/dev/null 2>&1 || true
  else
    plasma-apply-colorscheme BreezeDark >/dev/null 2>&1 || true
  fi
fi
plasma-apply-colorscheme Omarchy >/dev/null 2>&1 || true

# Omarchy applies icons through GNOME settings, while Plasma reads the KDE
# [Icons] group. Keep both desktops on the icon family selected by the theme.
icon_theme="Yaru-blue"
if [[ -f $icons_file ]]; then
  icon_theme=$(tr -d '[:space:]' < "$icons_file")
fi
# Treat theme metadata as a theme identifier, never as a path.
if [[ ! $icon_theme =~ ^[A-Za-z0-9._+-]+$ ]]; then
  icon_theme="Yaru-blue"
fi

icon_theme_exists() {
  local root
  for root in "$HOME/.local/share/icons" "$HOME/.icons" /usr/local/share/icons /usr/share/icons; do
    [[ -f $root/$1/index.theme ]] && return 0
  done
  return 1
}

mode=$(omarchy-theme-color --file "$colors_file" mode 2>/dev/null || true)
if ! icon_theme_exists "$icon_theme"; then
  # Current Omarchy White/Vantablack metadata uses gray/grey names that the
  # Arch Yaru package does not ship. Preserve light/dark intent in that case.
  if [[ $mode == "light" ]] && icon_theme_exists Yaru; then
    icon_theme="Yaru"
  elif icon_theme_exists Yaru-dark; then
    icon_theme="Yaru-dark"
  else
    icon_theme="breeze-dark"
  fi
fi

# Yaru intentionally does not inherit KDE's Breeze theme, so Plasma-only names
# such as `keyboard-layout` otherwise resolve as a generic file. Keep the
# Omarchy-selected family first and fall back to the matching Breeze variant
# only for icons it does not provide.
# KDE caches an icon theme's inheritance chain by theme name. Give each
# Omarchy icon family its own wrapper so switching Yaru variants refreshes
# Dolphin's folder icons immediately while retaining Plasma's Breeze fallback.
plasma_icon_theme="Omarchy-Plasma-$icon_theme"
plasma_icon_dir="$HOME/.local/share/icons/$plasma_icon_theme"
if [[ $mode == "light" ]] && icon_theme_exists breeze; then
  plasma_icon_fallback="breeze"
else
  plasma_icon_fallback="breeze-dark"
fi
mkdir -p "$plasma_icon_dir/scalable/status"
plasma_icon_index="$plasma_icon_dir/index.theme"
plasma_icon_tmp="$plasma_icon_index.tmp.$$"
cat >"$plasma_icon_tmp" <<EOF
[Icon Theme]
Name=Omarchy Plasma
Comment=Omarchy icons with Plasma-specific fallbacks
Hidden=true
Inherits=$icon_theme,$plasma_icon_fallback,hicolor
Directories=scalable/status

[scalable/status]
Context=Status
Size=16
MinSize=8
MaxSize=512
Type=Scalable
EOF
mv "$plasma_icon_tmp" "$plasma_icon_index"

if [[ $hook_event != install && $hook_event != session-start ]] &&
   [[ $(kreadconfig6 --file kdeglobals --group Icons --key Theme 2>/dev/null) == "$plasma_icon_theme" ]]; then
  kwriteconfig6 --file kdeglobals --group Icons --key Theme --notify "$plasma_icon_fallback"
fi
kwriteconfig6 --file kdeglobals --group Icons --key Theme --notify "$plasma_icon_theme"

current_background=$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null || true)
if [[ -f $current_background ]]; then
  "$HOME/.local/bin/plasmarchy-sync-wallpaper" "$current_background"
fi

if [[ $hook_event != install && $hook_event != session-start ]] &&
   [[ ${XDG_CURRENT_DESKTOP:-} == *KDE* ]] &&
   [[ -x $HOME/.local/bin/plasmarchy-restart-shell ]]; then
  setsid -f "$HOME/.local/bin/plasmarchy-restart-shell" >/dev/null 2>&1
fi
