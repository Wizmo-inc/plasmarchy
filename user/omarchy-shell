#!/bin/bash

# Route Omarchy IPC to the Plasma hybrid instance while KDE is active. Keep
# the packaged command untouched and use it normally in a Hyprland session.

quiet=0
if [[ ${1:-} == "-q" ]]; then
  quiet=1
  shift
fi

hybrid_path="$HOME/.config/quickshell/plasma-omarchy"

if [[ ${XDG_CURRENT_DESKTOP:-} == *KDE* ]] && qs list --all 2>/dev/null | grep -Fq "$hybrid_path/shell.qml"; then
  command_args=("$@")
  if [[ ${1:-} == shell && ( ${2:-} == summon || ${2:-} == toggle ) && $# == 3 ]]; then
    set -- "$1" "$2" "$3" "{}"
  fi

  output=$(timeout --kill-after=1s 2s qs ipc -n -p "$hybrid_path" call -- "$@" 2>/dev/null)
  status=$?
  if (( status != 0 )); then
    (( quiet )) && exit 0
    echo "Plasma Omarchy shell is not responding" >&2
    exit "$status"
  fi
  if [[ ${command_args[0]:-} == background && ${command_args[1]:-} == set ]]; then
    "$HOME/.local/bin/plasmarchy-sync-wallpaper" "${command_args[2]:-}"
  fi
  (( quiet )) || [[ -z $output ]] || printf '%s\n' "$output"
  exit 0
fi

if (( quiet )); then
  exec /usr/bin/omarchy-shell -q "$@"
else
  exec /usr/bin/omarchy-shell "$@"
fi
