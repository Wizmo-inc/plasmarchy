{
  "version": 1,
  "disabledPlugins": [
    "omarchy.background",
    "omarchy.lock",
    "omarchy.polkit"
  ],
  "idle": {
    "screensaver": 0,
    "lock": 0
  },
  "bar": {
    "position": "bottom",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "plasma.launcher"
        },
        {
          "id": "plasma.workspaces"
        },
        {
          "id": "plasma.tasks",
          "launchers": [
            {
              "title": "Files",
              "icon": "system-file-manager",
              "desktopId": "org.kde.dolphin",
              "command": ["dolphin"]
            },
            {
              "title": "Terminal",
              "icon": "utilities-terminal",
              "desktopId": "foot",
              "command": ["omarchy-launch-terminal"]
            },
            {
              "title": "Google Chrome",
              "icon": "google-chrome",
              "desktopId": "google-chrome",
              "command": ["omarchy-launch-browser"]
            }
          ]
        },
        {
          "id": "omarchy.active-window",
          "maxWidth": 220
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "plasma.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omatask"
        },
        {
          "id": "plasma.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "plasma.show-desktop"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "plasma.menu"
    }
  ]
}
