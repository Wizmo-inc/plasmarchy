+    else if (action === "unpin") delete next[root.appActionId]
+    root.pinnedAppIds = next
+    var helper = Quickshell.env("HOME") + "/.local/bin/plasmarchy-quicklaunch"
+    var args = [helper, action, root.appActionId, root.appActionLabel, root.appActionIcon]
+    root.cancel()
+    Quickshell.execDetached(args)
+  }
