+  function normalizeDesktopId(value) {
+    var id = String(value || "").trim()
+    return id.slice(-8) === ".desktop" ? id.slice(0, -8) : id
+  }
+
+  function loadPinnedApps(rawText) {
+    var next = ({})
+    try {
+      var config = JSON.parse(String(rawText || "{}"))
+      var layout = config.bar && config.bar.layout ? config.bar.layout : ({})
+      var sections = ["left", "center", "right"]
+      for (var s = 0; s < sections.length; ++s) {
+        var entries = Array.isArray(layout[sections[s]]) ? layout[sections[s]] : []
+        for (var i = 0; i < entries.length; ++i) {
+          if (!entries[i] || entries[i].id !== "plasma.tasks") continue
+          var launchers = Array.isArray(entries[i].launchers) ? entries[i].launchers : []
+          for (var j = 0; j < launchers.length; ++j) {
+            var id = root.normalizeDesktopId(launchers[j].desktopId)
+            if (id) next[id] = true
+          }
+        }
+      }
+    } catch (error) { }
+    root.pinnedAppIds = next
+  }
+
+  function isPinned(appId) {
+    return root.pinnedAppIds[root.normalizeDesktopId(appId)] === true
+  }
+
+  function openAppActions(appId, label, icon) {
+    appActions.appId = root.normalizeDesktopId(appId)
+    appActions.appLabel = String(label || appId)
+    appActions.appIcon = String(icon || "application-x-executable")
+    // Defer until the right-click event has fully completed. Otherwise its
+    // release can be treated as an outside click and dismiss the popup.
+    Qt.callLater(function() { appActions.popup() })
+  }
+
+  function performAppAction(action) {
+    if (!appActions.appId) return
+    var next = ({})
+    for (var id in root.pinnedAppIds) next[id] = root.pinnedAppIds[id]
+    if (action === "pin") next[appActions.appId] = true
+    else if (action === "unpin") delete next[appActions.appId]
+    root.pinnedAppIds = next
+    var helper = Quickshell.env("HOME") + "/.local/bin/plasmarchy-quicklaunch"
+    var args = [helper, action, appActions.appId, appActions.appLabel, appActions.appIcon]
+    root.cancel()
+    Quickshell.execDetached(args)
+  }
